{
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.4.1"
		}
	},
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "v52.0.1",
		"mediawiki/mediawiki-phan-config": "0.20.0",
		"mediawiki/minus-x": "2.0.1",
		"php-parallel-lint/php-console-highlighter": "v1.0.0",
		"php-parallel-lint/php-parallel-lint": "v1.4.0",
		"phpunit/phpunit": "^13.0"
	},
	"scripts": {
		"fix": [
			"minus-x fix .",
			"phpcbf"
		],
		"test": [
			"parallel-lint . --exclude vendor --exclude node_modules",
			"phpcs -p -s",
			"minus-x check .",
			"@phpunit"
		],
		"phan": "phan -d . --long-progress-bar",
		"phpunit": "phpunit --fail-on-warning --fail-on-risky --bootstrap vendor/autoload.php phpunit"
	},
	"require": {
		"ext-json": "*",
		"php": ">=8.4"
	},
	"name": "mediawiki/lud",
	"type": "mediawiki-extension",
	"description": "Ludian dictionary import and display tools",
	"license": "GPL-2.0-or-later",
	"autoload-dev": {
		"psr-4": {
			"MediaWiki\\Extensions\\Lud\\": "src/"
		}
	}
}
